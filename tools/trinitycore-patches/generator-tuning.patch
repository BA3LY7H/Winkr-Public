--- a/src/common/mmaps_common/Generator/TileBuilder.h
+++ b/src/common/mmaps_common/Generator/TileBuilder.h
@@ -27,6 +27,32 @@
 
 namespace MMAP
 {
+    // Recast's contour simplification tolerance, in VOXELS. TC ships 1.8,
+    // which at the default 0.2666 yd cell lets a mesh border sit up to 0.48 yd
+    // away from the true walkable boundary -- half a yard, which in a city is
+    // far enough to put walkable surface inside a wall. Lowering it keeps the
+    // border on the geometry at the cost of more polys. Left at 1.8 unless
+    // --simplify says otherwise, so a default bake is unchanged.
+    inline float g_maxSimplificationError = 1.8f;
+
+    // Detail-mesh sampling, in CELLS. TC ships 16, which at the default 0.2666
+    // yd cell samples terrain height only every 4.27 yd -- the detail mesh is
+    // what getPolyHeight reads, so this is what decides whether the mesh sits on
+    // the ground or hovers over a dip between samples. It costs detail verts and
+    // triangles but NOT routing polys, so it buys height accuracy without
+    // touching the poly budget that --simplify 0.4 blew.
+    // Agent envelope in YARDS. TC's defaults describe a server-side NPC, not a
+    // player character -- and this repo's own LiveMesh disagrees with every one
+    // of them (dinkr_livemesh.cpp: height 2.0, climb 1.0, radius 0.6, slope 50).
+    // A mesh built to 1.6 yd height walks under arches a 2 yd player cannot fit
+    // through; one built to 1.6 yd climb bridges ledges a player cannot step up.
+    inline float g_agentHeightYd = 1.6f;
+    inline float g_agentClimbYd  = 1.6f;
+    inline float g_agentRadiusYd = 0.5333333f;
+
+    inline float g_detailSampleDist = 16.0f;
+    inline float g_detailSampleMaxError = 1.0f;
+
 struct TileConfig;
 
